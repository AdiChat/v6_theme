{{!< default}}

{{!-- Custom page template. Create a Ghost Page with slug "ai-conferences".
Renders /assets/conferences.json (curated list). Put conferences.json in the
theme's assets/ folder so it is served at /assets/conferences.json. --}}

<style>
.ogc{
  --ink:#1d1d1f;
  --ink2:#6e6e73;
  --hair:#e3e6ea;
  --surf:#f5f5f7;
  --acc:#3eb0ef;
  --acc2:#1d7fd4;
  --red:#d23b3b;
  --amber:#b25e00;
  --green:#1a7f4b;
  color:var(--ink);
  line-height:1.6;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
}

.ogc a{
  color:var(--acc);
  text-decoration:none;
}

.ogc .wrap{
  max-width:920px;
  margin:0 auto;
  padding:0 24px;
}

.ogc .hero{
  position:relative;
  background:linear-gradient(135deg,#0a3d6b 0%,#1d7fd4 58%,#3eb0ef 100%);
  color:#fff;
  text-align:center;
  padding:64px 24px 52px;
}

.ogc .hero_logo{
  position:absolute;
  top:16px;
  left:22px;
  height:30px;
  filter:brightness(0) invert(1);
  opacity:.95;
}

.ogc .hero h1{
  font-size:clamp(30px,6vw,50px);
  line-height:1.08;
  letter-spacing:-.022em;
  font-weight:700;
  margin:0 auto 12px;
  max-width:20ch;
}

.ogc .hero .sub{
  color:#c7c9cc;
  font-size:clamp(15px,2.2vw,19px);
  max-width:60ch;
  margin:0 auto 8px;
}

.ogc .hero .upd{
  color:#8a8d91;
  font-size:13px;
  margin-top:12px;
}

.ogc .hero .list-cta{
  display:inline-block;
  margin-top:20px;
  background:#fff;
  color:var(--acc2);
  font-weight:700;
  padding:11px 22px;
  border-radius:10px;
}

.ogc section{
  padding:40px 0;
}

.ogc h2{
  font-size:20px;
  letter-spacing:-.01em;
  margin:0 0 14px;
}

.ogc .filters{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-bottom:10px;
}

.ogc .filters input,
.ogc .filters select{
  font:inherit;
  padding:9px 12px;
  border:1px solid var(--hair);
  border-radius:9px;
  background:#fff;
  color:var(--ink);
}

.ogc .filters input{
  flex:1;
  min-width:200px;
}

.ogc .filters .clear{
  background:var(--surf);
  border:1px solid var(--hair);
  color:var(--ink2);
  cursor:pointer;
}

.ogc .legend{
  font-size:12px;
  color:var(--ink2);
  margin:0 0 18px;
}

.ogc .legend b{
  font-weight:700;
}

.ogc .legend .dot{
  display:inline-block;
  width:9px;
  height:9px;
  border-radius:50%;
  margin:0 4px 0 12px;
  vertical-align:middle;
}

.ogc .conf{
  display:flex;
  align-items:center;
  gap:16px;
  border:1px solid var(--hair);
  border-radius:12px;
  padding:14px 18px;
  margin-bottom:10px;
}

.ogc .conf.feat{
  border-color:var(--acc);
  background:#f5fbff;
}

.ogc .conf .date{
  text-align:center;
  min-width:64px;
}

.ogc .conf .date .mo{
  font-size:12px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.04em;
  color:var(--acc);
}

.ogc .conf .date .dy{
  font-size:22px;
  font-weight:800;
  line-height:1;
}

.ogc .conf .date .yr{
  font-size:12px;
  color:var(--ink2);
}

.ogc .conf .mid{
  flex:1;
  min-width:0;
}

.ogc .conf .mid .nm{
  font-weight:700;
}

.ogc .conf .mid small{
  display:block;
  color:var(--ink2);
  font-size:13px;
}

.ogc .conf .mid .tag{
  display:inline-block;
  font-size:11px;
  color:var(--ink2);
  background:var(--surf);
  border:1px solid var(--hair);
  border-radius:980px;
  padding:1px 9px;
  margin:4px 6px 0 0;
}

.ogc .conf .mid .tag.tier{
  color:#5b3ea6;
  background:#f3effb;
  border-color:#e0d6f5;
  font-weight:700;
}

.ogc .conf .mid .tag.free{
  color:var(--green);
  background:#eefaf2;
  border-color:#cfefdb;
  font-weight:700;
}

.ogc .conf .mid .tag.metric{
  color:#0b5cda;
  background:#eef5fc;
  border-color:#d3e5f7;
}

.ogc .conf .mid .diff{
  font-weight:700;
}

.ogc .conf .mid .diff.d1{
  color:var(--green);
  background:#eefaf2;
  border-color:#cfefdb;
}

.ogc .conf .mid .diff.d2{
  color:#0b5cad;
  background:#eef5fc;
  border-color:#d3e5f7;
}

.ogc .conf .mid .diff.d3{
  color:var(--amber);
  background:#fff6e9;
  border-color:#f0d9b5;
}

.ogc .conf .mid .diff.d4{
  color:var(--red);
  background:#fdecec;
  border-color:#f6c9c9;
}

.ogc .conf .right{
  text-align:right;
  white-space:nowrap;
}

.ogc .conf .cfp{
  font-size:12px;
  font-weight:700;
  border-radius:980px;
  padding:3px 10px;
  display:inline-block;
  margin-bottom:8px;
}

.ogc .conf .cfp.soon{
  color:#fff;
  background:var(--red);
}

.ogc .conf .cfp.near{
  color:#fff;
  background:var(--amber);
}

.ogc .conf .cfp.open{
  color:var(--green);
  background:#eefaf2;
  border:1px solid #cfefdb;
}

.ogc .conf .cfp.closed{
  color:var(--ink2);
  background:var(--surf);
  border:1px solid var(--hair);
}

.ogc .conf .details{
  display:block;
  border:1px solid var(--acc);
  color:var(--acc);
  padding:7px 15px;
  border-radius:8px;
  font-weight:600;
  font-size:14px;
}

.ogc .badge{ font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#fff; background:var(--acc); border-radius:980px; padding:2px 9px; }
.ogc .more{ display:block; margin:6px auto 0; background:#fff; border:1px solid var(--acc); color:var(--acc); font:inherit; font-weight:600; padding:10px 24px; border-radius:9px; cursor:pointer; }
.ogc .muted{ color:var(--ink2); }
@media(max-width:640px){
  .ogc .conf{ flex-wrap:wrap; }
  .ogc .conf .date{ min-width:52px; }
  .ogc .conf .right{ width:100%; text-align:left; }
  .ogc .conf .details{ display:inline-block; }
}
</style>

{{#post}}
{{> "site-nav"}}
<div class="ogc">

<header class="hero">
    <img class="hero_logo" src="/assets/images/IQ_Logo.svg" alt="OpenGenus">
    <div class="wrap">
        <h1>AI &amp; ML Conferences</h1>
        <p class="sub">Upcoming AI / ML conferences with submission deadlines, dates, location and price - tracked by OpenGenus so you never miss a CFP.</p>
        <p class="upd" id="ogc-updated"></p>
        <a class="list-cta" href="mailto:team@opengenus.org?subject=AI%20conference%20to%20add">Know a conference we missed? Tell us ↗</a>
    </div>
</header>

<section><div class="wrap">
    <div id="ogc-featured"></div>
    <h2 id="ogc-heading">Conferences</h2>

    <div class="filters">
        <input id="ogc-q" type="search" placeholder="Search name or city…">

        <select id="ogc-topic"></select>

        <select id="ogc-tier"></select>

        <select id="ogc-difficulty">
            <option value="">Any difficulty</option>
            <option value="Beginner-friendly">Beginner-friendly</option>
            <option value="Moderate">Moderate</option>
            <option value="Competitive">Competitive</option>
            <option value="Very competitive">Very competitive</option>
        </select>

        <select id="ogc-mode"></select>

        <select id="ogc-country"></select>

        <select id="ogc-deadline">
            <option value="">Any deadline</option>
            <option value="open">CFP open</option>
            <option value="d30">Due &le; 30 days</option>
            <option value="d90">Due &le; 90 days</option>
            <option value="none">No open CFP</option>
        </select>

        <select id="ogc-price">
            <option value="">Any price</option>
            <option value="free">Free</option>
            <option value="lt500">&le; $500</option>
            <option value="mid">$500 - $1500</option>
            <option value="gt1500">$1500+</option>
        </select>
                <select id="ogc-sort">
            <option value="deadline">Sort: deadline soonest</option>
            <option value="date">Sort: event date</option>
            <option value="accept">Sort: acceptance rate (easiest)</option>
            <option value="h5">Sort: impact (h5-index)</option>
            <option value="name">Sort: name</option>
        </select>
        <button class="clear" id="ogc-clear">Clear</button>
    </div>

    <p class="legend">Deadline urgency:
        <span class="dot" style="background:#d23b3b"></span>&le; 14 days
        <span class="dot" style="background:#b25e00"></span>&le; 45 days
        <span class="dot" style="background:#1a7f4b"></span>open
        &nbsp; &nbsp; <b>Tier</b> A* = top-tier academic · Industry = practitioner event
    </p>

    <div id="ogc-list"><p class="muted">Loading conferences…</p></div>
    <button class="more" id="ogc-more" style="display:none">Load more</button>
</div></section>
</div>

<script>
(function(){

var PAGE = 12;
var MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
var TIER_ORDER = ["A*","A","B","Regional","Workshop","Industry"];
var TIER_DIFF = {
    "A*":"Very competitive",
    "A":"Competitive",
    "B":"Moderate",
    "Regional":"Beginner-friendly",
    "Workshop":"Beginner-friendly"
};

var DIFF_CLASS = {
    "Beginner-friendly":"d1",
    "Moderate":"d2",
    "Competitive":"d3",
    "Very competitive":"d4"
};

var NOW = new Date();
var ALL = [];
var state = {
    q:"",
    topic:"",
    tier:"",
    difficulty:"",
    mode:"",
    country:"",
    deadline:"",
    price:"",
    sort:"deadline",
    shown:PAGE
};

var $ = function(id){
    return document.getElementById(id);
};

function daysTo(iso){
    if(!iso) return null;
    return Math.ceil((new Date(iso) - NOW)/86400000);
}

// difficulty from acceptance rate when known, else a tier-based estimate.
// Industry (talk CFPs) => N/A.

function difficultyOf(c){
    if(c.tier==="Industry") return "-";
    var a = c.accept_rate;
    if(a!=null){
        return a<0.20 ? "Very competitive"
             : a<0.35 ? "Competitive"
             : a<0.50 ? "Moderate"
             : "Beginner-friendly";
    }
    return TIER_DIFF[c.tier] || "-";
}

function acceptPct(c){
    return (c.accept_rate!=null)
        ? Math.round(c.accept_rate*100)+"%"
        : null;
}

function fmtDate(iso){
    if(!iso) return "";
    var d = new Date(iso);
    return MONTHS[d.getUTCMonth()]+" "+
           d.getUTCDate()+", "+
           d.getUTCFullYear();
}

function priceLabel(p){
    if(p===0) return "Free";
    if(p==null) return "Varies";
    return "$"+p;
}

function priceBucket(p){
    if(p===0) return "free";
    if(p==null) return "varies";
    if(p<=500) return "lt500";
    if(p<=1500) return "mid";
    return "gt1500";
}

function cfpChip(c){
    var d = daysTo(c.deadline);

    if(d==null)
        return '<span class="cfp closed">No open CFP</span>';

    if(d < 0)
        return '<span class="cfp closed">'+
               (c.deadline_type||"CFP")+
               ' closed</span>';

    var cls = d<=14 ? "soon"
            : (d<=45 ? "near" : "open");

    return '<span class="cfp '+cls+'">'+
           (c.deadline_type||"CFP")+
           ' · '+fmtDate(c.deadline)+
           ' · in '+d+'d</span>';
}

function card(c, feat){
    var d = new Date(c.start);
    var free = c.price===0;
    var diff = difficultyOf(c);
    var ap = acceptPct(c);
    var tags = '<span class="tag">'+c.topic+'</span>' +
        '<span class="tag tier">'+c.tier+'</span>' +
        (diff!=="-" ? '<span class="tag diff '+(DIFF_CLASS[diff]||'')+'">'+diff+'</span>' : '') +
        (ap ? '<span class="tag metric">Accept '+ap+'%</span>' : '') +
        (c.h5!=null ? '<span class="tag metric">h5 '+c.h5+'</span>' : '') +
        '<span class="tag '+(free?'free':'')+'">'+priceLabel(c.price)+'</span>';
    var badge = feat ? '<span class="badge">Featured</span>' : '';
    return '<div class="conf'+(feat?' feat':'')+'">'+
        '<div class="date"><div class="mo">'+MONTHS[d.getUTCMonth()]+'</div><div class="dy">'+d.getUTCDate()+'</div><div class="yr">'+d.getUTCFullYear()+'</div></div>'+
        '<div class="mid"><div class="nm">'+badge+(c.name||'')+'</div>'+
        '<small>'+(c.full||'')+'</small>'+
        '<small>'+fmtDate(c.start)+' → '+fmtDate(c.end)+
        ' · '+(c.city||'')+', '+(c.country||'')+
        ' · '+(c.mode||'')+'</small>'+
        '<div>'+tags+'</div></div>'+
        '<div class="right">'+fcfChip(c)+
        '<a class="details" href="'+(c.url||'#')+'" target="_blank" rel="noopener">Details ↗</a></div></div>';
}

function uniq(key){
    var s={};
    ALL.forEach(function(c){
        if(c[key]) s[c[key]]=1;
    });
    return Object.keys(s).sort();
}

function fillSelect(el,label,vals){
    el.innerHTML='<option value="">'+label+'</option>'+
        vals.map(function(v){
            return '<option value="'+v+'">'+v+'</option>';
        }).join('');
}

function filtered(){
    var q = state.q.toLowerCase();
    return ALL.filter(function(c){
        if(state.topic && c.topic !== state.topic) return false;
        if(state.tier && c.tier !== state.tier) return false;
        if(state.difficulty && difficultyOf(c) !== state.difficulty) return false;
        if(state.mode && c.mode !== state.mode) return false;
        if(state.country && c.country !== state.country) return false;
        if(state.price && priceBucket(c.price) !== state.price) return false;

        var d = daysTo(c.deadline);
        if(state.deadline==="open" && !(d!=null && d>=0)) return false;
        if(state.deadline==="d30" && !(d!=null && d>=0 && d<=30)) return false;
        if(state.deadline==="d90" && !(d!=null && d>=0 && d<=90)) return false;
        if(state.deadline==="none" && d!==null && d>=0) return false;

        if(q && ((c.name||'')+" "+(c.full||'')+" "+(c.city||''))
            .toLowerCase().indexOf(q)<0)
            return false;

        return true;
    });
}

function sorted(list){
    var s = state.sort;
    return list.slice().sort(function(a,b){
        if(s==="name") return a.name.localeCompare(b.name);
        if(s==="date") return new Date(a.start) - new Date(b.start);
        if(s==="accept"){
            var aa = a.accept_rate,
                bb = b.accept_rate;
            if(aa==null&&ab==null) return 0; if(aa==null) return 1; if(ab==null) return -1; return ab-aa; }
if(s==="h5"){ var ha=a.h5, hb=b.h5;
    if(ha==null&&hb==null) return 0; if(ha==null) return 1; if(hb==null) return -1; return hb-ha; }
var da=daysTo(a.deadline), db=daysTo(b.deadline);
var oa=(da!=null && da>=0), ob=(db!=null && db>=0);
if(oa && ob) return da - db;
if(oa) return -1; if(ob) return 1;
return new Date(a.start) - new Date(b.start);
});
}

function render(){
    var res = sorted(filtered());
    var slice = res.slice(0, state.shown);
    $("ogc-heading").textContent = "Conferences (" + res.length + ")";
    $("ogc-list").innerHTML = res.length
        ? slice.map(function(c){ return card(c,false); }).join("")
        : '<p class="muted">No conferences match - try clearing filters.</p>';
    $("ogc-more").style.display = res.length > state.shown ? "block" : "none";
}

function onSel(id,key){ $(id).addEventListener("change", function(e){ state[key]=e.target.value; state.shown=PAGE; render(); }); }

fetch('/assets/conferences.json?'+Date.now()).then(function(r){return r.json();}).then(function(d){
    if(d.updated){ $("ogc-updated").textContent = "Last updated: " + d.updated; }
    var feat = d.featured || [];
    if(feat.length){ $("ogc-featured").innerHTML = "<h2>Featured</h2>" + feat.map(function(c){ return card(c,true); }).join(""); }
    ALL = d.conferences || [];
    var tiersPresent = uniq("tier");
    fillSelect($("ogc-topic"), "All topics", uniq("topic"));
    fillSelect($("ogc-tier"), "All tiers", TIER_ORDER.filter(function(t){ return tiersPresent.indexOf(t)>=0; }));
    fillSelect($("ogc-mode"), "All formats", uniq("mode"));
    fillSelect($("ogc-country"), "All countries", uniq("country"));
    var t;
    $("ogc-q").addEventListener("input", function(e){
        clearTimeout(t); var v=e.target.value;
        t = setTimeout(function(){ state.q=v; state.shown=PAGE; render(); }, 150);
    });
    onSel("ogc-topic","topic"); onSel("ogc-tier","tier"); onSel("ogc-difficulty","difficulty");
    onSel("ogc-mode","mode"); onSel("ogc-country","country");
    onSel("ogc-deadline","deadline"); onSel("ogc-price","price"); onSel("ogc-sort","sort");
    $("ogc-more").addEventListener("click", function(){ state.shown += PAGE; render(); });
    $("ogc-clear").addEventListener("click", function(){
        state = { q:"", topic:"", tier:"", difficulty:"", mode:"", country:"", deadline:"", price:"", sort:"deadline", shown:PAGE };
        ["ogc-q","ogc-topic","ogc-tier","ogc-difficulty","ogc-mode","ogc-country","ogc-deadline","ogc-price"].forEach(function(id){ $(id).value=""; });
        $("ogc-sort").value="deadline"; render();
    });
    render();
}).catch(function(){
    $("ogc-list").innerHTML = '<p class="muted">Conference list is being updated. Please check back shortly.</p>';
});
})();
</script>
{{/post}}